/plan:
  summary: TMT/FMF plan for running the rpmdeplint tests
  description: |
    Runs rpmdeplint tests in Fedora CI — https://github.com/fedora-ci/rpmdeplint-pipeline.

  discover:
    - name: x86_64
      how: fmf
      adjust-tests:
        - environment+:
            arch: x86_64
    - name: aarch64
      how: fmf
      adjust-tests:
        - environment+:
            arch: aarch64
  provision:
    how: container
    image: fedora

  prepare:
    - how: install
      copr: "@osci/rpmdeplint"
    - how: shell
      script: |
        echo "DIST_GIT_BRANCH=$@{dist-git-branch}" >> $TMT_PLAN_ENVIRONMENT_FILE

  execute:
    how: tmt

/steps:
  /prepare:
    summary: Prepare the environment for rpmdeplint
    duration: 30m
    order: 50
    test: |
      if [[ -n "$BODHI_UPDATE_ID" ]]; then
        ./prepare.py --arch=$arch bodhi-update $BODHI_UPDATE_ID
      elif [[ -n "$KOJI_TASK_ID" ]]; then
        ./prepare.py --arch=$arch koji-task $KOJI_TASK_ID
      else
        echo "Could not determine how to prepare the repo"
        exit 1
      fi
    require:
      - bodhi
      - koji
      - createrepo

  /check:
    order: 60
    require:
      - rpmdeplint
      - koji
    test: ./run_rpmdeplint.py $DIST_GIT_BRANCH --arch=$arch
    duration: 20m
    /sat:
      test+: " --check sat"
    /upgrade:
      test+: " --check upgrade"
    /conflicts:
      test+: " --check conflicts"
    # repoclosure is not run because rmdepcheck does it more efficently
